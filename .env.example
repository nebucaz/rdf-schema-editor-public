# Variables for `docker compose` (docker-compose.yml). Copy to `.env` — it is git-ignored.
# The backend's own settings (GraphDB, AUTH_JWT_SECRET, USER_JWT_SECRET, ...) live in backend/.env.

# Service JWT the frontend's nginx injects as `Authorization: Bearer <token>` on every /api/ request.
# It must be an HS512 token signed with the backend's AUTH_JWT_SECRET (>= 64 bytes). After upgrading
# from an HS256 build, re-mint it. Mint one with
#   cd backend && AUTH_JWT_SECRET=<value from backend/.env> go run ./cmd/cli mint-token --sub frontend-app
BACKEND_AUTH_TOKEN=

# Host port the app is published on (the backend itself is never published). Default 8080.
FRONTEND_PORT=8080

# Build-time deployment paths (spec/deployment-req) — passed to the frontend image build as build args,
# so the image serves exactly one path. Both optional; empty = app at "/" and backend at "/api".
# The enterprise gateway is expected to strip both prefixes before traffic reaches nginx:
#   <APP_BASE_PATH>/...      -> nginx /...
#   <API_PREFIX>/api/...     -> nginx /api/...
# e.g. APP_BASE_PATH=/path  API_PREFIX=/prefix. Rebuild the image (`docker compose build frontend`) after changing.
APP_BASE_PATH=
API_PREFIX=
