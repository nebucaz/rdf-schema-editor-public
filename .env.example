# Variables for `docker compose` (docker-compose.yml). Copy to `.env` — it is git-ignored.
# The backend's own settings (GraphDB, AUTH_JWT_SECRET, USER_JWT_SECRET, ...) live in backend/.env.

# Service JWT the frontend's nginx injects as `Authorization: Bearer <token>` on every /api/ request.
# It must be signed with the backend's AUTH_JWT_SECRET. Mint one with
#   cd backend && AUTH_JWT_SECRET=<value from backend/.env> go run ./cmd/cli mint-token --sub frontend-app
BACKEND_AUTH_TOKEN=

# Host port the app is published on (the backend itself is never published). Default 8080.
FRONTEND_PORT=8080
