{
	"name": "app",
	"private": true,
	"version": "1.0.9",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3": "^7.4.3",
		"@types/n3": "1.26.1",
		"@types/node": "^26.2.0",
		"jsdom": "26",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.9.1",
		"@xyflow/svelte": "^1.6.3",
		"d3": "^7.9.0",
		"html-to-image": "^1.11.13",
		"mode-watcher": "^1.1.0",
		"n3": "1.26.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
