# SPARQL Endpoint Configuration (Server-side)
SPARQL_ENDPOINT_URL=
SPARQL_USER=
SPARQL_PASSWORD=

# Schema/shapes namespace + named-graph configuration (client-visible — read via
# $env/dynamic/public, so these must be prefixed with PUBLIC_). Leave unset to use this app's
# built-in defaults (see src/lib/config.ts). Quote the value if it ends in "#" — dotenv otherwise
# reads an unquoted trailing "#" as a comment marker and silently truncates it.
PUBLIC_SCHEMA_NAMESPACE="http://ld.pageagent.com/rdf-schema-editor/schema#"
PUBLIC_SHAPES_NAMESPACE="http://ld.pageagent.com/rdf-schema-editor/shapes#"
PUBLIC_SCHEMA_GRAPH="http://ld.pageagent.com/rdf-schema-editor/graph"
