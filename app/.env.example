# Dev-only (`bun run dev`): the Vite dev server proxies /api to the Go backend and strips the prefix,
# standing in for nginx. DEV_BACKEND_AUTH_TOKEN is the service JWT it injects as `Authorization: Bearer`
# (mint with `go run ./cmd/cli mint-token --sub frontend-app`; an older app/.env's BACKEND_URL /
# BACKEND_AUTH_TOKEN are used when these are unset). Read by vite.config.ts only; never bundled.
DEV_BACKEND_URL=http://localhost:8090
DEV_BACKEND_AUTH_TOKEN=
