    arm-s:NAME "Kernbanking" ;
    arm-s:A_TECHNICAL_ID "1001" ;
    arm-s:A_APP_CMP_TYPE enum:Applikation ;
    arm-s:A_OBJECT_STATE enum:Freigegeben .

