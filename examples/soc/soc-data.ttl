# =============================================================================
# SOC sample — instance data: soc-data.ttl
#
# Namespace prefix: soc
# Namespace base IRI: http://ld.pageagent.com/example/soc
#
# Import with Import Turtle... while the `soc` namespace is the active namespace,
# after soc-schema.ttl and soc-shapes.ttl. Individuals live in <base>#.
#
# All data is synthetic: addresses come from the RFC 5737 documentation ranges
# (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24) and hostnames from example.com.
# =============================================================================

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix socs: <http://ld.pageagent.com/example/soc/schema#> .
@prefix soc:  <http://ld.pageagent.com/example/soc#> .

# -- Enumeration members ------------------------------------------------------

soc:severityLow a socs:Severity ; rdfs:label "Low" .
soc:severityMedium a socs:Severity ; rdfs:label "Medium" .
soc:severityHigh a socs:Severity ; rdfs:label "High" .
soc:severityCritical a socs:Severity ; rdfs:label "Critical" .

soc:outcomeSuccess a socs:Outcome ; rdfs:label "Success" .
soc:outcomeFailure a socs:Outcome ; rdfs:label "Failure" .

soc:alertStatusOpen a socs:AlertStatus ; rdfs:label "Open" .
soc:alertStatusInvestigating a socs:AlertStatus ; rdfs:label "Investigating" .
soc:alertStatusClosed a socs:AlertStatus ; rdfs:label "Closed" .

soc:criticalityLow a socs:Criticality ; rdfs:label "Low" .
soc:criticalityMedium a socs:Criticality ; rdfs:label "Medium" .
soc:criticalityHigh a socs:Criticality ; rdfs:label "High" .

# -- Servers ------------------------------------------------------------------

soc:web-01 a socs:Server ;
    rdfs:label "web-01" ;
    socs:hostname "web-01.example.com" ;
    socs:ipAddress "198.51.100.101" ;
    socs:operatingSystem "Ubuntu 22.04" ;
    socs:role "web" ;
    socs:criticality soc:criticalityMedium .

soc:web-02 a socs:Server ;
    rdfs:label "web-02" ;
    socs:hostname "web-02.example.com" ;
    socs:ipAddress "198.51.100.102" ;
    socs:operatingSystem "Ubuntu 22.04" ;
    socs:role "web" ;
    socs:criticality soc:criticalityMedium .

soc:app-01 a socs:Server ;
    rdfs:label "app-01" ;
    socs:hostname "app-01.example.com" ;
    socs:ipAddress "198.51.100.103" ;
    socs:operatingSystem "Debian 12" ;
    socs:role "app" ;
    socs:criticality soc:criticalityHigh .

soc:db-01 a socs:Server ;
    rdfs:label "db-01" ;
    socs:hostname "db-01.example.com" ;
    socs:ipAddress "198.51.100.104" ;
    socs:operatingSystem "Debian 12" ;
    socs:role "database" ;
    socs:criticality soc:criticalityHigh .

soc:bastion-01 a socs:Server ;
    rdfs:label "bastion-01" ;
    socs:hostname "bastion-01.example.com" ;
    socs:ipAddress "198.51.100.105" ;
    socs:operatingSystem "Ubuntu 22.04" ;
    socs:role "bastion" ;
    socs:criticality soc:criticalityHigh .

soc:dc-01 a socs:Server ;
    rdfs:label "dc-01" ;
    socs:hostname "dc-01.example.com" ;
    socs:ipAddress "198.51.100.106" ;
    socs:operatingSystem "Windows Server 2022" ;
    socs:role "domain controller" ;
    socs:criticality soc:criticalityHigh .

# -- Log files ----------------------------------------------------------------
# Only the auth logs (and Security.evtx) record authentication events; the others are noise.

soc:web-01-auth-log a socs:LogFile ;
    rdfs:label "web-01 auth.log" ;
    socs:path "/var/log/auth.log" ;
    socs:format "sshd" ;
    socs:hostedOn soc:web-01 .

soc:web-02-auth-log a socs:LogFile ;
    rdfs:label "web-02 auth.log" ;
    socs:path "/var/log/auth.log" ;
    socs:format "sshd" ;
    socs:hostedOn soc:web-02 .

soc:app-01-auth-log a socs:LogFile ;
    rdfs:label "app-01 auth.log" ;
    socs:path "/var/log/auth.log" ;
    socs:format "sshd" ;
    socs:hostedOn soc:app-01 .

soc:db-01-auth-log a socs:LogFile ;
    rdfs:label "db-01 auth.log" ;
    socs:path "/var/log/auth.log" ;
    socs:format "sshd" ;
    socs:hostedOn soc:db-01 .

soc:bastion-01-auth-log a socs:LogFile ;
    rdfs:label "bastion-01 auth.log" ;
    socs:path "/var/log/auth.log" ;
    socs:format "sshd" ;
    socs:hostedOn soc:bastion-01 .

soc:dc-01-security-evtx a socs:LogFile ;
    rdfs:label "dc-01 Security.evtx" ;
    socs:path "C:\\Windows\\System32\\winevt\\Logs\\Security.evtx" ;
    socs:format "Windows Security" ;
    socs:hostedOn soc:dc-01 .

soc:web-01-access-log a socs:LogFile ;
    rdfs:label "web-01 access.log" ;
    socs:path "/var/log/nginx/access.log" ;
    socs:format "nginx" ;
    socs:hostedOn soc:web-01 .

soc:db-01-postgresql-log a socs:LogFile ;
    rdfs:label "db-01 postgresql.log" ;
    socs:path "/var/log/postgresql/postgresql.log" ;
    socs:format "postgresql" ;
    socs:hostedOn soc:db-01 .

soc:app-01-app-log a socs:LogFile ;
    rdfs:label "app-01 app.log" ;
    socs:path "/var/log/app/app.log" ;
    socs:format "application" ;
    socs:hostedOn soc:app-01 .

# -- Detection rules ----------------------------------------------------------

soc:ruleSshBruteForce a socs:DetectionRule ;
    rdfs:label "SSH brute force" ;
    socs:ruleName "SSH brute force" ;
    socs:technique "T1110.001" ;
    socs:description "Many failed SSH logins from one source, optionally followed by a success." .

soc:rulePasswordSpray a socs:DetectionRule ;
    rdfs:label "Password spray" ;
    socs:ruleName "Password spray" ;
    socs:technique "T1110.003" ;
    socs:description "One source tries a few passwords against many accounts or hosts." .

soc:ruleOffHoursPrivilegedLogin a socs:DetectionRule ;
    rdfs:label "Off-hours privileged login" ;
    socs:ruleName "Off-hours privileged login" ;
    socs:technique "T1078" ;
    socs:description "A privileged account logs in outside business hours." .

# -- Authentication events ----------------------------------------------------

