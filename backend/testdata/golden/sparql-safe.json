        "catalog": "http://example.org/ns/catalog"
      }
    },
    {
      "name": "trailing slash is normalised",
      "baseIri": "http://example.org/ns/",
      "graphs": {
        "instances": "http://example.org/ns",
        "schema": "http://example.org/ns/schema",
        "shapes": "http://example.org/ns/shapes",
        "catalog": "http://example.org/ns/catalog"
      }
    },
    {
      "name": "base that itself ends in a graph word",
      "baseIri": "http://example.org/ns/schema",
      "graphs": {
        "instances": "http://example.org/ns/schema",
