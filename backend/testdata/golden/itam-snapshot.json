	"sparqlConstraints": [
		{
			"shapeIri": "https://lida.pnet.ch/arm/schema#ApplikationskomponenteNameFormatModulShape",
			"targetClass": "https://lida.pnet.ch/arm/schema#Applikationskomponente",
			"select": "\n            SELECT $this ?value\n                   (<https://lida.pnet.ch/arm/schema#NAME> AS ?path)\n            WHERE {\n                # Guard: A_APP_CMP_TYPE equals Applikationsmodul\n                $this\n                    <https://lida.pnet.ch/arm/schema#A_APP_CMP_TYPE> <https://lida.pnet.ch/enum/Applikationsmodul> ;\n                    <https://lida.pnet.ch/arm/schema#NAME> ?value .\n\n                FILTER (\n                    !isLiteral(?value)\n                    ||\n                    !REGEX(\n                        STR(?value),\n                        \"^[A-Z][A-Za-z0-9]{2,15}\\\\.[A-Za-z0-9 &-]{3,39}$\"\n                    )\n                )\n            }\n        ",
			"message": "Modulname verletzt die Namens-Konvention (Abkuerzung.Modulname, Modulteil 4-40 Zeichen).",
			"ruleId": "AC-NAME-FORMAT-MODUL",
			"qualityDimension": "Validity (Syntactic)"
		},
		{
			"shapeIri": "https://lida.pnet.ch/arm/schema#ApplikationskomponenteNameUniqueShape",
			"targetClass": "https://lida.pnet.ch/arm/schema#Applikationskomponente",
			"select": "\n            SELECT DISTINCT\n                $this\n                ?value\n                (<https://lida.pnet.ch/arm/schema#NAME> AS ?path)\n            WHERE {\n                $this\n                    <https://lida.pnet.ch/arm/schema#NAME> ?value .\n\n                ?other\n                    a <https://lida.pnet.ch/arm/schema#Applikationskomponente> ;\n                    <https://lida.pnet.ch/arm/schema#NAME> ?value .\n\n                FILTER (?other != $this)\n            }\n        ",
			"message": "Name ist nicht eindeutig ueber alle Application Components.",
			"ruleId": "AC-NAME-UNIQUE",
			"qualityDimension": "Uniqueness"
		},
		{
			"shapeIri": "https://lida.pnet.ch/arm/schema#ApplikationskomponenteSpecAcceptedShape",
			"targetClass": "https://lida.pnet.ch/arm/schema#Applikationskomponente",
			"select": "\n            SELECT\n                $this\n                ?value\n                (<https://lida.pnet.ch/arm/schema#A_APP_CMP_TYPE> AS ?path)\n            WHERE {\n                $this\n                    <https://lida.pnet.ch/arm/schema#A_OBJECT_STATE> <https://lida.pnet.ch/enum/Freigegeben> .\n\n                OPTIONAL {\n                    $this\n                        <https://lida.pnet.ch/arm/schema#A_APP_CMP_TYPE> ?value .\n                }\n\n                FILTER (\n                    !BOUND(?value)\n                    ||\n                    ?value NOT IN (\n                        <https://lida.pnet.ch/enum/Applikation>,\n                        <https://lida.pnet.ch/enum/Applikationsmodul>\n                    )\n                )\n            }\n        ",
			"message": "Freigegebene Application Component muss Spezialisierung Applikation oder Applikationsmodul haben.",
			"ruleId": "AC-SPEC-ACCEPTED",
			"qualityDimension": "Validity (Domain)"
		},
		{
			"shapeIri": "https://lida.pnet.ch/arm/schema#ApplikationskomponenteTechnicalIdExistsShape",
			"targetClass": "https://lida.pnet.ch/arm/schema#Applikationskomponente",
			"select": "\n            SELECT\n                $this\n                ?value\n                (<https://lida.pnet.ch/arm/schema#A_TECHNICAL_ID> AS ?path)\n            WHERE {\n                $this\n                    <https://lida.pnet.ch/arm/schema#A_TECHNICAL_ID> ?value .\n\n                FILTER (\n                    isLiteral(?value)\n                    &&\n                    STRLEN(\n                        REPLACE(STR(?value), \"^\\\\s+|\\\\s+$\", \"\")\n                    ) = 0\n                )\n            }\n        ",
			"message": "Technische ID fehlt.",
			"ruleId": "AC-TECHID-EXIST",
			"qualityDimension": "Completeness (Attribute)"
		},
