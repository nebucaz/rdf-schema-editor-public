# GraphDB Configuration (this service is the sole thing that talks to GraphDB directly — see
# spec/report/plan.md's ADR "SPARQL gateway migration timing")
GRAPHDB_ENDPOINT_URL=http://localhost:7201/repositories/rdfschema
GRAPHDB_USER=
GRAPHDB_PASSWORD=

# Port this service listens on (optional, defaults to 8090)
PORT=8090

# Schema namespace base IRI (optional) — same value/variable name as app/.env's
# PUBLIC_SCHEMA_NAMESPACE, used to derive the `backstageKind` annotation-property IRI (Story 003).
# Leave unset to use this app's built-in default.
PUBLIC_SCHEMA_NAMESPACE="http://ld.pageagent.com/rdf-schema-editor/schema#"

# Backstage source configuration (spec/report/plan.md, Story 003) — optional; the service still
# starts as a pure SPARQL gateway without these, but /sources/backstage/* routes fail at call time
# until both are set.
BACKSTAGE_BASE_URL=
BACKSTAGE_TOKEN=

# How often BackstageSyncWorker ticks a real (non-dry-run) sync (Story 008) — a Go time.Duration
# string, e.g. "1h", "30m". Optional, defaults to "1h". Manual/CLI-triggered syncs (dry-run or real)
# via POST /sources/{source}/sync are unaffected by this interval.
BACKSTAGE_SYNC_INTERVAL=1h

# HS256 signing secret for service-to-service JWTs (spec/threat-mitigation/plan.md, Story 001) —
# required, the backend fails to start without it. Shared between the verification middleware
# (Story 002, checks every request except /health) and the `importctl mint-token` minting tool
# (Story 003, mints the frontend's and importctl's own static tokens). Generate a long random
# value, e.g. `openssl rand -base64 32`.
AUTH_JWT_SECRET=

# Extra browser origins CSRFGuard accepts on state-changing routes (comma-separated, e.g.
# "https://app.example") — optional. A request whose Origin equals its Host is always accepted;
# set this when a proxy rewrites Host and does not forward the original.
ALLOWED_ORIGINS=

# HS256 secret verifying the end-user access token in the `Oglala` cookie (static-frontend, Story
# 003) — optional; without it GET /me always reports no user. Keep it different from
# AUTH_JWT_SECRET so a leaked user key cannot mint service tokens.
USER_JWT_SECRET=

# Dev-only login routes (POST /auth/dev-login, /auth/logout; static-frontend Stories 004/005) and
# the matching button in the UI. Never enable in production. Optional, defaults to false.
DEV_LOGIN_ENABLED=false

# Set `Secure` on the dev-login cookie — enable when serving over HTTPS; leave off for plain-HTTP
# dev. APP_ENV=production makes the backend refuse to start with DEV_LOGIN_ENABLED=true, which also
# requires USER_JWT_SECRET.
COOKIE_SECURE=false
APP_ENV=
