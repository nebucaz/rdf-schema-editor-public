# GraphDB Configuration (this service is the sole thing that talks to GraphDB directly — see
# spec/report/plan.md's ADR "SPARQL gateway migration timing")
GRAPHDB_ENDPOINT_URL=http://localhost:7201/repositories/rdfschema
GRAPHDB_USER=
GRAPHDB_PASSWORD=

# Port this service listens on (optional, defaults to 8090)
PORT=8090

# Schema namespace base IRI (optional) — same value/variable name as app/.env's
# PUBLIC_SCHEMA_NAMESPACE, used to derive the `backstageKind` annotation-property IRI (Story 003).
# Leave unset to use this app's built-in default.
PUBLIC_SCHEMA_NAMESPACE="http://ld.pageagent.com/rdf-schema-editor/schema#"

# Backstage source configuration (spec/report/plan.md, Story 003) — optional; the service still
# starts as a pure SPARQL gateway without these, but /sources/backstage/* routes fail at call time
# until both are set.
BACKSTAGE_BASE_URL=
BACKSTAGE_TOKEN=

# How often BackstageSyncWorker ticks a real (non-dry-run) sync (Story 008) — a Go time.Duration
# string, e.g. "1h", "30m". Optional, defaults to "1h". Manual/CLI-triggered syncs (dry-run or real)
# via POST /sources/{source}/sync are unaffected by this interval.
BACKSTAGE_SYNC_INTERVAL=1h

# HS512 signing secret for service-to-service JWTs (spec/threat-mitigation/plan.md, Story 001) —
# required, the backend fails to start without it. Shared between the verification middleware
# (Story 002, checks every request except /health) and the `importctl mint-token` minting tool
# (Story 003, mints the frontend's and importctl's own static tokens). Generate a long random
# value of at least 64 bytes (HS512, RFC 7518 §3.2; shorter is refused at startup),
# e.g. `openssl rand -base64 64`.
AUTH_JWT_SECRET=

# Extra browser origins CSRFGuard accepts on state-changing routes (comma-separated, e.g.
# "https://app.example") — optional. A request whose Origin equals its Host is always accepted;
# set this when a proxy rewrites Host and does not forward the original.
ALLOWED_ORIGINS=

# HS512 secret verifying the end-user access token in the `Oglala` cookie (static-frontend, Story
# 003) — at least 64 bytes when set; optional; without it GET /me always reports no user. Keep it different from
# AUTH_JWT_SECRET so a leaked user key cannot mint service tokens.
USER_JWT_SECRET=

# Dev-only login routes (POST /auth/dev-login, /auth/logout; static-frontend Stories 004/005) and
# the matching button in the UI. Never enable in production. Optional, defaults to false.
DEV_LOGIN_ENABLED=false

# Set `Secure` on the dev-login cookie — enable when serving over HTTPS; leave off for plain-HTTP
# dev. APP_ENV=production makes the backend refuse to start with DEV_LOGIN_ENABLED=true, which also
# requires USER_JWT_SECRET.
COOKIE_SECURE=false
APP_ENV=

# Workflow tool for validation issues (spec/validation-issues-tracker) — optional. The template turns an
# issue's external id into a link: an https URL containing {id}, e.g.
# https://example.service-now.com/nav_to.do?uri=incident.do?number={id}
# An invalid template (not https, no {id}) refuses startup. Empty = no links. No API calls are made.
ISSUE_TRACKER_URL_TEMPLATE=
# Display label for that tool, e.g. ServiceNow.
ISSUE_TRACKER_NAME=

# ServiceNow ticket integration (spec/service-now-ticket) — optional. ONLY SERVICENOW_BASE_URL switches it on:
# empty = no ticket routes, no client, no worker, the UI shows no ticket control. A set but incomplete or
# non-https configuration refuses startup.
SERVICENOW_BASE_URL=
# oauth (client credentials against <base>/oauth_token.do) or basic. Required when the base URL is set.
SERVICENOW_AUTH=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Table of the tickets, default incident.
SERVICENOW_TABLE=incident
# false switches off the sync worker and the automatic pushes; creating tickets by hand stays available.
SERVICENOW_SYNC_ENABLED=true
# How often the worker pulls ticket changes and pushes local ones (Go duration, at least 1m, default 15m).
SERVICENOW_SYNC_INTERVAL=15m
# What a finding that is gone does to its ticket: comment (work note only, default) or resolve (also move it
# to Resolved with the close code below).
SERVICENOW_ON_FINDING_GONE=comment
# The stored close_code sent when resolving; overrides closeCode of the config file. Default
# "Resolved – Permanent Fix Applied".
SERVICENOW_CLOSE_CODE=
# Most tickets one bulk run creates (default 25); the rest of the selection is reported as deferred.
SERVICENOW_BULK_CAP=25
# Public URL of this app including its base path; the ticket description links back to
# <this>/validation?finding=<id>. Empty leaves the link out.
SERVICENOW_APP_URL=
# JSON file with the structured settings (validated at startup, optional): the state map, the close code sent
# when a finding is gone and the routing from a finding's identity to an assignment group.
#   {"stateMap": {"1": "open", "2": "in-progress", "6": "resolved", "8": "wontfix"},
#    "closeCode": "Resolved – Permanent Fix Applied",
#    "routing": {"predicateIri": "https://example.org/schema#authoritativeEntity",
#                "fallbackGroup": "Data Stewardship", "unrouted": "block",
#                "map": {"https://example.org/org#Finance": {"assignmentGroup": "Finance Apps", "contact": "jdoe",
#                                                           "category": "software", "impact": "2", "urgency": "2"},
#                        "default": {"category": "inquiry", "impact": "3", "urgency": "3"}}}}
SERVICENOW_CONFIG_FILE=
